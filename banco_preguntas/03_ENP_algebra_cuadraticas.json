      {
        "id": "C",
        "texto": "$t = 5\\text{ s y } t = 15\\text{ s}$",
        "es_correcta": false
      },
      {
        "id": "D",
        "texto": "$t = 7\\text{ s y } t = 13\\text{ s}$",
