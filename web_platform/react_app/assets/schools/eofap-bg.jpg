<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <radialGradient id="bg" cx="50%" cy="30%" r="80%">
      <stop offset="0%" stop-color="#00F0FF" stop-opacity="0.45"/>
      <stop offset="60%" stop-color="#0A192F" stop-opacity="0.95"/>
      <stop offset="100%" stop-color="#050811" stop-opacity="1"/>
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#00F0FF" stroke-width="0.5" stroke-opacity="0.2"/>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#bg)"/>
  <rect width="100%" height="100%" fill="url(#grid)"/>
  <circle cx="400" cy="200" r="160" fill="none" stroke="#00F0FF" stroke-width="2" stroke-dasharray="6 6" opacity="0.4"/>
  <circle cx="400" cy="200" r="110" fill="none" stroke="#00F0FF" stroke-width="1.5" opacity="0.3"/>
  <text x="400" y="235" font-size="110" text-anchor="middle" fill="#00F0FF" opacity="0.85">✈</text>
  <text x="400" y="320" font-family="sans-serif" font-size="24" font-weight="bold" text-anchor="middle" fill="#FFFFFF" letter-spacing="4">EOFAP · AVIACIÓN MILITAR</text>
  <text x="400" y="355" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle" fill="#00F0FF" letter-spacing="6">FUERZA AÉREA DEL PERÚ</text>
</svg>